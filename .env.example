# Скопируй в .env и заполни. Файл .env не коммить.
# Секрет для подписи токенов: любая длинная случайная строка, например `openssl rand -base64 32`
JWT_SECRET=
# для docker compose (пароль базы в контейнере)
DB_PASSWORD=
# для запуска без Docker с локальной PostgreSQL (см. README)
DATABASE_URL=postgres://localhost:5432/mentor
DATABASE_USER=mentor
DATABASE_PASSWORD=
# отдельная база для тестов – тест создаёт и удаляет в ней данные
TEST_DATABASE_URL=postgresql://mentor:пароль@localhost:5432/mentor_test
# Web Client ID из Google Cloud Console (APIs & Services → Credentials)
GOOGLE_CLIENT_ID=
# true – разрешить вход без Google (только для разработки!)
AUTH_DEV=false
# токен для GET /admin/stats (заголовок X-Admin-Token)
ADMIN_TOKEN=
# внешняя модель ИИ (OpenAI-совместимый API); без ключа работает офлайн-проверка
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=
