# Скопируй в .env и заполни. Файл .env не коммить.
# Секрет для подписи токенов: любая длинная случайная строка, например `openssl rand -base64 32`
JWT_SECRET=
DB_PASSWORD=
# Web Client ID из Google Cloud Console (APIs & Services → Credentials)
GOOGLE_CLIENT_ID=
# true – разрешить вход без Google (только для разработки!)
AUTH_DEV=false
# токен для GET /admin/stats (заголовок X-Admin-Token)
ADMIN_TOKEN=
# внешняя модель ИИ (OpenAI-совместимый API); без ключа работает офлайн-проверка
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=
