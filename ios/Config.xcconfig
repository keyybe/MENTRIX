// Настройки сборки iOS-приложения.
// Свои значения лучше писать в Config.local.xcconfig (он в .gitignore), чтобы не попали в репозиторий.
// В xcconfig «//» начинает комментарий, поэтому в адресах пишем «/$()/».

// Адрес боевого сервера для Release-сборки
MENTOR_SERVER_URL_RELEASE = https:/$()/api.example.com/

// Адрес сервера для Debug-сборки. localhost подходит только для симулятора –
// для iPhone укажи в Config.local.xcconfig адрес Mac в сети, например http:/$()/имя-mac.local:8080/
MENTOR_SERVER_URL_DEBUG = http:/$()/localhost:8080/

// OAuth client ID типа iOS из Google Cloud Console. Пусто – кнопка «Войти через Google» скрыта.
GOOGLE_IOS_CLIENT_ID =

// Команда разработчика для подписи (для запуска на iPhone)
DEVELOPMENT_TEAM =

#include? "Config.local.xcconfig"
