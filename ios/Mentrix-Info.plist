<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Адрес сервера и Google Client ID задаются в Config.xcconfig -->
	<key>MentorServerURL</key>
	<string>$(MENTOR_SERVER_URL)</string>
	<key>GoogleClientID</key>
	<string>$(GOOGLE_IOS_CLIENT_ID)</string>
	<!-- http://localhost:8080 для разработки в симуляторе -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
